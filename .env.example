# Personal access token with `repo` scope (classic) or fine-grained read/write
# access to the repositories you want the agent to touch.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: restrict the server to a single owner/repo instead of whatever
# the caller asks for. Leave unset to allow any repo the token can access.
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Path to the SQLite database file. Created automatically if it doesn't exist.
DATABASE_PATH=./data/app.sqlite
